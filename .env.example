# Optional. The app starts without it.
SARVAM_API_KEY=your_sarvam_key_here

# Optional. Leave empty to use the local default. Letters and digits only.
# For a public deployment, set your own before the database is first created.
POSTGRES_PASSWORD=

# Optional, for testing: "local" sends the AI step (replies the rules cannot parse, names in English letters)
# to a small local model instead of Sarvam. Listening and speaking still use Sarvam. Leave empty for Sarvam.
AI_PROVIDER=
# Where the local model's OpenAI-compatible server is. Docker Compose defaults to the local-ai service.
# For local development without Docker: http://localhost:8080/v1
LOCAL_AI_URL=
